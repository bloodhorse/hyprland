# extras.lst — quality of life. Not required for Hyprland to come up.
#
# Lines tagged [AUR] go through yay (already installed on miniarch as yay-bin).
# 00-packages.sh will NOT bootstrap an AUR helper if one is missing — it prints the
# names and moves on.

# ── browser ────────────────────────────────────────────────────────────
zen-browser-bin       # [AUR] bound to Alt+Z in hyprland.conf; already installed
helium-browser-bin    # [AUR] alt-s lane; the mac's main browser
# tridactyl native messenger: NOT a package. The AUR only has firefox-tridactyl-native
# (firefox paths, stale since apr 2026) — useless for zen. Install from inside the
# browser instead: tridactyl's `:installnative` drops the messenger where zen looks.
# First-boot manual step; tridactylrc's :native commands are inert until then.

# ── shell ──────────────────────────────────────────────────────────────
zoxide                # bash/.bashrc calls `zoxide init bash` — bashrc errors out without it
fzf
starship              # the init line in .bashrc is commented out; here for when it isn't

# ── audio control ──────────────────────────────────────────────────────
pavucontrol           # the `vol` alias in .bashrc
