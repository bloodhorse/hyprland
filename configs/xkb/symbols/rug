// ЙЦУКЕН behind keyd's Gallium: keyd sends the Gallium letter of each physical key,
// so every key here answers with the Russian letter of the physical seat that sent it.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ru(winkeys)"
    name[Group1] = "Russian (under Gallium)";
    key <AB01> { [ Cyrillic_i, Cyrillic_I ] };
    key <AB02> { [ Cyrillic_ya, Cyrillic_YA ] };
    key <AB03> { [ Cyrillic_ka, Cyrillic_KA ] };
    key <AB04> { [ Cyrillic_ie, Cyrillic_IE ] };
    key <AB05> { [ Cyrillic_shorti, Cyrillic_SHORTI ] };
    key <AB06> { [ Cyrillic_ef, Cyrillic_EF ] };
    key <AB07> { [ Cyrillic_es, Cyrillic_ES ] };
    key <AB08> { [ Cyrillic_ze, Cyrillic_ZE ] };
    key <AB10> { [ Cyrillic_be, Cyrillic_BE ] };
    key <AC01> { [ Cyrillic_el, Cyrillic_EL ] };
    key <AC02> { [ Cyrillic_a, Cyrillic_A ] };
    key <AC03> { [ Cyrillic_u, Cyrillic_U ] };
    key <AC04> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN ] };
    key <AC05> { [ Cyrillic_pe, Cyrillic_PE ] };
    key <AC06> { [ Cyrillic_o, Cyrillic_O ] };
    key <AC07> { [ Cyrillic_en, Cyrillic_EN ] };
    key <AC08> { [ Cyrillic_te, Cyrillic_TE ] };
    key <AC09> { [ Cyrillic_tse, Cyrillic_TSE ] };
    key <AC10> { [ Cyrillic_yu, Cyrillic_YU ] };
    key <AD01> { [ Cyrillic_che, Cyrillic_CHE ] };
    key <AD02> { [ Cyrillic_em, Cyrillic_EM ] };
    key <AD03> { [ Cyrillic_de, Cyrillic_DE ] };
    key <AD04> { [ Cyrillic_yeru, Cyrillic_YERU ] };
    key <AD05> { [ Cyrillic_ve, Cyrillic_VE ] };
    key <AD06> { [ Cyrillic_ghe, Cyrillic_GHE ] };
    key <AD07> { [ Cyrillic_shcha, Cyrillic_SHCHA ] };
    key <AD08> { [ Cyrillic_zhe, Cyrillic_ZHE ] };
    key <AD09> { [ Cyrillic_sha, Cyrillic_SHA ] };
    key <AD10> { [ Cyrillic_er, Cyrillic_ER ] };
    key <AB09> { [ period, comma ] };
};
