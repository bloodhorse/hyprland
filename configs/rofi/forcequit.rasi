* {
    font: "Inter 13";
    background-color: transparent;
    text-color: #cdd6f4;
}
window {
    width: 33%;
    location: center;
    background-color: #1e1e2eee;
    border: 2px;
    border-color: #f38ba8;
    border-radius: 14px;
    padding: 10px;
}
mainbox {
    children: [ message, listview ];
}
listview {
    lines: 9;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
}
element {
    padding: 9px 12px;
    border-radius: 9px;
    spacing: 12px;
    children: [ element-icon, element-text ];
}
element selected {
    background-color: #313244;
}
element-icon {
    size: 24px;
}
element-text {
    vertical-align: 0.5;
}
message {
    padding: 4px 12px 10px 12px;
}
textbox {
    text-color: #f38ba8;
}
