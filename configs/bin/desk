#!/usr/bin/env bash
name=$(hyprctl activeworkspace -j | jq -r .name)
mark="${XDG_RUNTIME_DIR:-/tmp}/desk-${name//[^a-zA-Z0-9]/_}"

out() {
    [ -s "$mark" ] && return
    hyprctl clients -j | jq -r --arg w "$name" '.[] | select(.workspace.name == $w and .mapped) | .address' >"$mark"
    [ -s "$mark" ] || return
    hyprctl --batch "$(sed 's/.*/dispatch setprop address:& opacity 0 ; dispatch setprop address:& opacity_override 1/' "$mark" | paste -sd ';')" >/dev/null
}

back() {
    [ -s "$mark" ] || return
    hyprctl --batch "$(sed 's/.*/dispatch setprop address:& opacity 1 ; dispatch setprop address:& opacity_override unset/' "$mark" | paste -sd ';')" >/dev/null
    rm -f "$mark"
}

case "${1:-toggle}" in
out) out ;;
in) back ;;
toggle) [ -s "$mark" ] && back || out ;;
*) echo "desk [toggle|out|in]"; exit 2 ;;
esac
