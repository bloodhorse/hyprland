#!/usr/bin/env bash
ws=$(hyprctl activeworkspace -j)
name=$(jq -r .name <<<"$ws")
[[ $name =~ ^[0-9]+$ ]] && target=$name || target="name:$name"
stash="special:desk-${name//[^a-zA-Z0-9]/_}"
here() { hyprctl clients -j | jq -r --arg w "$1" '.[] | select(.workspace.name == $w and .mapped) | .address'; }

out() {
    here "$name" | while read -r a; do
        hyprctl dispatch movetoworkspacesilent "$stash,address:$a" >/dev/null
    done
}

back() {
    here "$stash" | while read -r a; do
        hyprctl dispatch movetoworkspacesilent "$target,address:$a" >/dev/null
    done
}

case "${1:-toggle}" in
out) out ;;
in) back ;;
toggle) [ -n "$(here "$stash")" ] && back || out ;;
*) echo "desk [toggle|out|in]"; exit 2 ;;
esac
