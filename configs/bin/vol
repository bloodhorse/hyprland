#!/bin/sh
sink=@DEFAULT_AUDIO_SINK@
case "$1" in
    up)
        wpctl set-mute $sink 0
        wpctl set-volume -l 1.0 $sink 5%+
        ;;
    down)
        wpctl set-volume $sink 5%-
        ;;
    mute)
        wpctl set-mute $sink toggle
        ;;
esac
v=$(wpctl get-volume $sink)
case "$v" in *MUTED*) kind=mute ;; *) kind=volume ;; esac
qs -c osd ipc call osd pop $kind Volume "$(echo "$v" | awk '{print $2}')" 2>/dev/null
