#!/usr/bin/env python3
import json
import os
import re
import socket
import subprocess
import time

MAP = os.path.expanduser("~/.local/state/wallws.json")


def load():
    try:
        with open(MAP) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def current():
    out = subprocess.run(["awww", "query"], capture_output=True, text=True).stdout
    m = re.search(r"image: (.+)$", out.strip())
    return m.group(1) if m else None


def show(name):
    walls = load()
    path = walls.get(name) or walls.get("default")
    if not path or not os.path.exists(path) or path == current():
        return
    subprocess.run(["awww", "img", path, "--transition-type", "fade",
                    "--transition-duration", "0.35", "--transition-fps", "60"],
                   capture_output=True)
    subprocess.Popen([os.path.expanduser("~/.local/bin/house-colors"), path],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def listen():
    path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                        os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                return
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                event, _, data = line.decode("utf-8", "replace").partition(">>")
                if event == "workspacev2":
                    show(data.split(",", 1)[1])


walls = load()
if "default" not in walls and (here := current()):
    walls["default"] = here
    os.makedirs(os.path.dirname(MAP), exist_ok=True)
    with open(MAP, "w") as f:
        json.dump(walls, f, indent=1)
active = json.loads(subprocess.run(["hyprctl", "-j", "activeworkspace"], capture_output=True, text=True).stdout or "{}")
if active.get("name"):
    show(active["name"])

while True:
    try:
        listen()
    except (OSError, KeyError):
        pass
    time.sleep(1)
