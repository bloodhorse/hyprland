#!/usr/bin/env bash
if [ -z "$1" ]; then
    exec qs -c house ipc call wall toggle
fi
kinds=(grow wave outer center wipe fade left right top bottom)
spots=(center top-left top-right bottom-left bottom-right)
awww img "$1" \
    --transition-type "${kinds[RANDOM % ${#kinds[@]}]}" \
    --transition-angle $((RANDOM % 8 * 45)) \
    --transition-pos "${spots[RANDOM % ${#spots[@]}]}" \
    --transition-step 140 \
    --transition-fps 120
ws=$(hyprctl activeworkspace -j | jq -r .name)
map=~/.local/state/wallws.json
[ -f "$map" ] || echo '{}' >"$map"
jq --arg ws "$ws" --arg p "$1" '.[$ws] = $p' "$map" >"$map.new" && mv "$map.new" "$map"
(~/.local/bin/house-colors "$1" >/dev/null 2>&1 &)
