#!/usr/bin/env bash
w=$(hyprctl activewindow -j)
addr=$(jq -r .address <<<"$w")
case "$(jq -r .class <<<"$w")" in
com.bekh.bare) hyprctl dispatch sendshortcut "CTRL,bracketleft,address:$addr" >/dev/null ;;
kitty|dropterm) hyprctl dispatch sendshortcut "CTRL ALT,bracketleft,address:$addr" >/dev/null ;;
*) hyprctl dispatch sendshortcut "ALT,Left,address:$addr" >/dev/null ;;
esac
