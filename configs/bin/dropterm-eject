#!/usr/bin/env python3
import json
import os
import socket
import subprocess
import time

SPECIAL = "special:term"
OWNER = "dropterm"


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def regular_workspace():
    for m in json.loads(hyprctl("-j", "monitors") or "[]"):
        if m.get("focused"):
            return m["activeWorkspace"]["id"]
    return None


def eject(address):
    ws = regular_workspace()
    if ws is None:
        return
    hyprctl("--batch",
            f"dispatch movetoworkspacesilent {ws},address:0x{address} ; "
            f"dispatch togglespecialworkspace term ; "
            f"dispatch focuswindow address:0x{address}")


def listen():
    path = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                        os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                return
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                event, _, data = line.decode("utf-8", "replace").partition(">>")
                if event != "openwindow":
                    continue
                address, workspace, cls, _ = (data.split(",", 3) + ["", "", ""])[:4]
                if workspace == SPECIAL and cls != OWNER:
                    eject(address)


while True:
    try:
        listen()
    except (OSError, KeyError):
        pass
    time.sleep(1)
