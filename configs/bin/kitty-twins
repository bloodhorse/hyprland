#!/bin/sh
src=${1:-$HOME/.config/kitty/kitty.conf}
awk '
function twin(chord,    n, p, i, key, c, s, m, out) {
    n = split(chord, p, "+"); key = p[n]; c = 0; s = 0; m = 0; had_shift = 0; had_alt = 0
    for (i = 1; i < n; i++) {
        if (p[i] == "cmd") { c = 1; s = 1 }
        else if (p[i] == "ctrl") c = 1
        else if (p[i] == "shift") { s = 1; had_shift = 1 }
        else if (p[i] == "alt") { m = 1; had_alt = 1 }
    }
    out = ""
    if (c) out = out "ctrl+"
    if (s) out = out "shift+"
    if (m) out = out "super+"
    return out key
}
$1 == "map" {
    ci = 2
    while ($ci ~ /^--/) { if ($ci == "--when-focus-on") ci += 2; else ci++ }
    chord = $ci
    if (chord !~ /(^|\+)cmd(\+|$)/) next
    n++
    t[n] = twin(chord); sh[n] = had_shift; al[n] = had_alt; orig[n] = chord
    line = $0
    pos = index(line, chord)
    pre[n] = substr(line, 1, pos - 1); post[n] = substr(line, pos + length(chord))
    if (!had_shift) plain[t[n]] = 1
}
END {
    for (i = 1; i <= n; i++) {
        if (sh[i] && (t[i] in plain)) continue
        print pre[i] t[i] post[i]
    }
    for (i = 1; i <= n; i++) {
        if (al[i] || (orig[i] in seen)) continue
        seen[orig[i]] = 1
        print "map " orig[i] " discard_event"
    }
}' "$src"
